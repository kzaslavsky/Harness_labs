{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "queue_run_id", "feature_run_id", "repair_generation", "diff_sha256", "tests_passed", "test_evidence", "findings"],
  "properties": {
    "protocol": {"type": "string", "const": "implement-v13-codex/targeted-review/1"},
    "queue_run_id": {"type": "string"},
    "feature_run_id": {"type": "string"},
    "repair_generation": {"type": "integer", "minimum": 1},
    "diff_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "tests_passed": {"type": "boolean"},
    "test_evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "findings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["fingerprint", "status", "evidence"],
        "properties": {
          "fingerprint": {"type": "string", "minLength": 1},
          "status": {"type": "string", "enum": ["fixed", "not_fixed", "regression"]},
          "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
