{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "feature_run_id", "state_revision", "attempts_before_escalation", "active_closure_id", "closures"],
  "properties": {
    "protocol": {"type": "string", "enum": ["implement-v13-codex/review-closure-ledger/1", "implement-v13-codex/review-closure-ledger/2", "implement-v13-codex/review-closure-ledger/3"]},
    "feature_run_id": {"type": "string", "minLength": 1},
    "state_revision": {"type": "integer", "minimum": 0},
    "attempts_before_escalation": {"type": "integer", "minimum": 1},
    "active_closure_id": {"type": "string"},
    "dependency_graph_status": {
      "type": "string",
      "enum": ["legacy_unbound", "validated"]
    },
    "dependency_graph_path": {"type": ["string", "null"]},
    "dependency_graph_sha256": {
      "type": ["string", "null"],
      "pattern": "^[0-9a-f]{64}$"
    },
    "scheduler_policy": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["max_ready_age", "retry_penalty"],
      "properties": {
        "max_ready_age": {"type": "integer", "minimum": 1},
        "retry_penalty": {"type": "integer", "minimum": 1}
      }
    },
    "scheduling_history": {
      "type": "array",
      "items": {"type": "object"}
    },
    "closures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": true,
        "required": ["closure_id", "fingerprints", "origin_reviewer", "complexity", "acceptance", "depends_on", "related_closures", "excluded_fingerprints", "status", "closure_test", "design", "attempts", "escalation_history"],
        "properties": {
          "closure_id": {"type": "string", "minLength": 1},
          "fingerprints": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "origin_reviewer": {"type": "string", "minLength": 1},
          "complexity": {"type": "string", "enum": ["implementation", "architectural"]},
          "acceptance": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "related_closures": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "excluded_fingerprints": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "status": {"type": "string", "enum": ["test_required", "design_required", "design_review_required", "ready_for_fix", "fix_running", "rereview_required", "closed", "escalation_required", "blocked"]},
          "closure_test": {"type": ["object", "null"]},
          "design": {"type": ["object", "null"]},
          "design_rejections": {"type": "array", "items": {"type": "object"}},
          "attempts": {"type": "array", "items": {"type": "object"}},
          "escalation_history": {"type": "array", "items": {"type": "object"}},
          "contract_resolution_history": {"type": "array", "items": {"type": "object"}},
          "design_rejection_baseline": {"type": ["integer", "null"], "minimum": 0},
          "attempt_rejection_baseline": {"type": ["integer", "null"], "minimum": 0},
          "active_resolution_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "budget_activation_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "resolution_sha256",
                "design_activated",
                "attempt_activated",
                "design_rejection_baseline",
                "attempt_rejection_baseline",
                "migration_recovery"
              ],
              "properties": {
                "resolution_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "design_activated": {"type": "boolean"},
                "attempt_activated": {"type": "boolean"},
                "design_rejection_baseline": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "attempt_rejection_baseline": {
                  "type": ["integer", "null"],
                  "minimum": 0
                },
                "migration_recovery": {"type": "boolean"}
              }
            }
          },
          "assertion_map_path": {"type": ["string", "null"]},
          "assertion_map_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "capability_manifest_path": {"type": ["string", "null"]},
          "capability_manifest_sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "write_surfaces": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "read_surfaces": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "source_bindings": {
            "type": "array",
            "items": {"type": "object"}
          },
          "immutable_test_nodes": {
            "type": "array",
            "items": {"type": "object"}
          },
          "dependency_edge_reasons": {
            "type": "array",
            "items": {"type": "object"}
          },
          "ready_age": {"type": "integer", "minimum": 0},
          "scheduler_rejections": {"type": "integer", "minimum": 0},
          "batch_history": {
            "type": "array",
            "items": {"type": "object"}
          },
          "regression_evidence": {
            "type": "array",
            "items": {"type": "object"}
          },
          "assertion_backfill_history": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "assertion_map_path",
                "assertion_map_sha256",
                "independent_verifier_role",
                "verification_receipt_id"
              ],
              "properties": {
                "assertion_map_path": {"type": "string", "minLength": 1},
                "assertion_map_sha256": {
                  "type": "string",
                  "pattern": "^[0-9a-f]{64}$"
                },
                "independent_verifier_role": {
                  "type": "string",
                  "minLength": 1
                },
                "verification_receipt_id": {
                  "type": "string",
                  "minLength": 1
                }
              }
            }
          }
        }
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "implement-v13-codex/review-closure-ledger/2"
          }
        },
        "required": ["protocol"]
      },
      "then": {
        "properties": {
          "closures": {
            "items": {
              "required": [
                "closure_id",
                "fingerprints",
                "origin_reviewer",
                "complexity",
                "acceptance",
                "depends_on",
                "related_closures",
                "excluded_fingerprints",
                "status",
                "closure_test",
                "design",
                "design_rejections",
                "attempts",
                "escalation_history",
                "contract_resolution_history",
                "design_rejection_baseline",
                "attempt_rejection_baseline",
                "active_resolution_sha256",
                "budget_activation_history",
                "assertion_map_path",
                "assertion_map_sha256",
                "capability_manifest_path",
                "capability_manifest_sha256"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "protocol": {
            "const": "implement-v13-codex/review-closure-ledger/3"
          }
        },
        "required": ["protocol"]
      },
      "then": {
        "required": [
          "dependency_graph_status",
          "dependency_graph_path",
          "dependency_graph_sha256",
          "scheduler_policy",
          "scheduling_history"
        ],
        "properties": {
          "closures": {
            "items": {
              "required": [
                "write_surfaces",
                "read_surfaces",
                "source_bindings",
                "immutable_test_nodes",
                "dependency_edge_reasons",
                "ready_age",
                "scheduler_rejections",
                "batch_history",
                "regression_evidence"
              ]
            }
          }
        }
      }
    }
  ]
}
