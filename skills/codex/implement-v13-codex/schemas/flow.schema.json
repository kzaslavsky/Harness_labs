{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/codex-phase-flow.schema.json",
  "title": "Codex phase flow",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "flow_id", "task", "prompt_catalog", "phases"],
  "properties": {
    "protocol": { "const": "codex-phase-flow/1" },
    "flow_id": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]{0,127}$" },
    "task": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "project_root": { "type": "string", "minLength": 1 },
    "max_context_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
    "context_catalog": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "role", "required"],
        "properties": {
          "path": { "type": "string", "minLength": 1 },
          "role": { "enum": ["governing", "background", "acceptance", "seed_plan"] },
          "required": { "type": "boolean" },
          "max_bytes": { "type": "integer", "minimum": 1, "maximum": 10485760 },
          "sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
        }
      }
    },
    "prompt_catalog": {
      "type": "object",
      "propertyNames": { "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["template", "context_ids", "output_schema"],
        "properties": {
          "template": { "type": "string", "minLength": 1 },
          "context_ids": {
            "type": "array",
            "uniqueItems": true,
            "items": { "type": "string", "minLength": 1 }
          },
          "output_schema": { "type": "string", "minLength": 1 }
        }
      }
    },
    "phases": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phase", "phase_detail", "model", "reasoning", "sandbox"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{0,127}$" },
          "phase": { "type": "string", "minLength": 1, "maxLength": 128 },
          "phase_detail": { "type": "string", "minLength": 1, "maxLength": 128 },
          "prompt_id": { "type": "string", "minLength": 1 },
          "model": { "type": "string", "minLength": 1 },
          "reasoning": { "enum": ["low", "medium"] },
          "sandbox": { "enum": ["read-only", "workspace-write"] }
        }
      }
    }
  }
}
