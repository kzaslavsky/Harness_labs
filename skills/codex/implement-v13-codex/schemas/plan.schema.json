{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "task", "scope", "governing_contracts", "source_evidence", "input_acknowledgements", "complexity", "ui_impact", "runtime_contracts", "steps", "task_dag", "critical_path_effort", "total_effort", "critical_path_share", "parallelization", "testing_strategy", "risks", "review_lenses"],
  "properties": {
    "protocol": {"type": "string", "const": "implement-v13-codex/1"},
    "task": {"type": "string", "minLength": 1},
    "scope": {"type": "object", "additionalProperties": false, "required": ["in", "out"], "properties": {"in": {"type": "array", "items": {"type": "string"}}, "out": {"type": "array", "items": {"type": "string"}}}},
    "governing_contracts": {"type": "array", "items": {"type": "string"}},
    "source_evidence": {"type": "array", "items": {"type": "string"}},
    "input_acknowledgements": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["input_id", "sha256", "role"], "properties": {"input_id": {"type": "string"}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "role": {"type": "string", "enum": ["governing", "background", "acceptance", "seed_plan"]}}}},
    "complexity": {"type": "string", "enum": ["low", "medium", "high"]},
    "ui_impact": {"type": "boolean"},
    "runtime_contracts": {"type": "array", "items": {"type": "string"}},
    "steps": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["id", "title", "effort", "dependencies", "write_paths", "targeted_tests"], "properties": {"id": {"type": "string", "minLength": 1}, "title": {"type": "string", "minLength": 1}, "effort": {"type": "number", "exclusiveMinimum": 0}, "dependencies": {"type": "array", "items": {"type": "string"}}, "write_paths": {"type": "array", "items": {"type": "string"}}, "targeted_tests": {"type": "array", "items": {"type": "string"}}}}},
    "task_dag": {"type": "object", "additionalProperties": false, "required": ["nodes", "edges"], "properties": {"nodes": {"type": "array", "items": {"type": "string"}}, "edges": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["from", "to"], "properties": {"from": {"type": "string"}, "to": {"type": "string"}}}}}},
    "critical_path_effort": {"type": "number", "minimum": 0},
    "total_effort": {"type": "number", "exclusiveMinimum": 0},
    "critical_path_share": {"type": "number", "minimum": 0, "maximum": 1},
    "parallelization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["recommended", "worker_groups", "shared_file_owner"],
      "properties": {
        "recommended": {"type": "boolean"},
        "worker_groups": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "step_ids", "write_paths"],
            "properties": {
              "id": {"type": "string"},
              "step_ids": {"type": "array", "items": {"type": "string"}},
              "write_paths": {"type": "array", "items": {"type": "string"}}
            }
          }
        },
        "shared_file_owner": {"type": ["string", "null"]}
      }
    },
    "testing_strategy": {"type": "array", "items": {"type": "string"}},
    "risks": {"type": "array", "items": {"type": "string"}},
    "review_lenses": {
      "type": "array",
      "minItems": 3,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "charge", "reason", "must_read"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "charge": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "must_read": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
