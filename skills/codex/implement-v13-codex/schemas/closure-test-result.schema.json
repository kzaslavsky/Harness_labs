{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "queue_run_id", "feature_run_id", "phase", "phase_detail", "role", "status", "observed_failure", "test_paths", "commands", "evidence", "repository_root", "repository_identity", "test_node_id", "test_source_path", "test_source_sha256", "assertions", "effect_contract"],
  "properties": {
    "protocol": {"type": "string", "const": "implement-v13-codex/closure-test-result/2"}, "queue_run_id": {"type": "string"}, "feature_run_id": {"type": "string"},
    "phase": {"type": "string"}, "phase_detail": {"type": "string"}, "role": {"type": "string"},
    "status": {"type": "string", "enum": ["passed", "blocked"]},
    "observed_failure": {"type": "boolean"},
    "test_paths": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "commands": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/test_command"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
    "repository_root": {"type": "string", "minLength": 1},
    "repository_identity": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_node_id": {"type": "string", "minLength": 1},
    "test_source_path": {"type": "string", "minLength": 1},
    "test_source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["assertion_id", "test_node_id", "observation_source", "source_sha256", "governed_artifact", "effect", "expected_disposition"],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "test_node_id": {"type": "string", "minLength": 1},
          "observation_source": {"type": "string", "minLength": 1},
          "source_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "governed_artifact": {"type": "string", "minLength": 1},
          "effect": {"$ref": "#/$defs/effect"},
          "expected_disposition": {"type": "string", "enum": ["must_persist", "must_remain_absent", "must_remain_unchanged"]}
        }
      }
    },
    "effect_contract": {"$ref": "#/$defs/effect_contract"}
  },
  "$defs": {
    "test_command": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "argv", "certification_runtime_sha256", "environment_profile"],
      "properties": {
        "protocol": {"type": "string", "const": "implement-v13-codex/test-command/1"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "certification_runtime_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "environment_profile": {"type": "string", "const": "controller_certification"}
      }
    },
    "effect_contract": {
      "type": "object", "additionalProperties": false,
      "required": ["protocol", "must_persist", "must_remain_absent", "must_remain_unchanged"],
      "properties": {
        "protocol": {"type": "string", "const": "implement-v13-codex/repair-effect-contract/1"},
        "must_persist": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "must_remain_absent": {"type": "array", "items": {"$ref": "#/$defs/effect"}},
        "must_remain_unchanged": {"type": "array", "items": {"$ref": "#/$defs/effect"}}
      }
    },
    "effect": {
      "type": "string", "enum": ["failure_checkpoint", "blocked_queue", "failure_summary", "failure_event", "success_result", "success_receipt", "integration_artifact", "dispatcher_acknowledgement", "base_git_state"]
    }
  }
}
