{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "closure_ledger_path", "closure_id", "strategy_family", "strategy_summary", "fixer_identity", "specs"],
  "properties": {
    "protocol": {"type": "string", "const": "implement-v13-codex/closure-program/1"},
    "closure_ledger_path": {"type": "string", "minLength": 1}, "closure_id": {"type": "string", "minLength": 1},
    "strategy_family": {"type": "string", "minLength": 1}, "strategy_summary": {"type": "string", "minLength": 1},
    "fixer_identity": {"type": "string", "minLength": 1},
    "specs": {"type": "object", "minProperties": 2, "maxProperties": 5, "additionalProperties": {"type": "string", "minLength": 1}},
    "repair_batch_path": {"type": "string", "minLength": 1},
    "batch_targeted_review_specs": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    },
    "gate_evidence_path": {"type": "string", "minLength": 1},
    "gate_receipt_path": {"type": "string", "minLength": 1},
    "interrupted_receipt_path": {"type": "string", "minLength": 1},
    "interrupted_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "interrupted_closure_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "routine_escalation": {
      "type": "object",
      "additionalProperties": true,
      "required": ["action", "reason", "evidence"],
      "properties": {
        "action": {"type": "string", "enum": ["reassign", "decompose", "operator"]},
        "reason": {"type": "string", "minLength": 1},
        "evidence": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "routine_programs": {
      "type": "object",
      "additionalProperties": {"type": "string", "minLength": 1}
    }
  }
}
