{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": true,
  "required": [
    "protocol",
    "status",
    "feature_run_id",
    "batch_sha256",
    "targeted_review_permitted",
    "gates",
    "created_at",
    "input_sha256"
  ],
  "properties": {
    "protocol": {"const": "implement-v13-codex/repair-gates/1"},
    "status": {"enum": ["passed", "failed"]},
    "feature_run_id": {"type": "string", "minLength": 1},
    "batch_sha256": {"$ref": "#/$defs/sha256"},
    "targeted_review_permitted": {"type": "boolean"},
    "gates": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["gate_class", "status", "elapsed_ms", "evidence"],
        "properties": {
          "gate_class": {
            "enum": [
              "forbidden_access",
              "pre_communication_output_bound",
              "process_evidence",
              "capability_manifest",
              "production_certification"
            ]
          },
          "status": {"enum": ["passed", "failed"]},
          "elapsed_ms": {"type": "number", "minimum": 0},
          "evidence": {"type": "object"}
        }
      }
    },
    "created_at": {"type": "string", "format": "date-time"},
    "input_sha256": {"$ref": "#/$defs/sha256"}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
