{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "feature_run_id",
    "repository_root",
    "repository_identity",
    "closures",
    "edges"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "implement-v13-codex/repair-dependency-graph/2"
    },
    "feature_run_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "repository_identity": {"$ref": "#/$defs/sha256"},
    "closures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "closure_id",
          "fingerprints",
          "origin_reviewer",
          "write_surfaces",
          "read_surfaces",
          "source_bindings",
          "immutable_test_nodes"
        ],
        "properties": {
          "closure_id": {"type": "string", "minLength": 1},
          "fingerprints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "origin_reviewer": {"type": "string", "minLength": 1},
          "write_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "read_surfaces": {
            "type": "array",
            "items": {"type": "string", "minLength": 1}
          },
          "source_bindings": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["surface", "path", "sha256"],
              "properties": {
                "surface": {"type": "string", "minLength": 1},
                "path": {"type": "string", "minLength": 1},
                "sha256": {"$ref": "#/$defs/sha256"}
              }
            }
          },
          "immutable_test_nodes": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "node_id",
                "source_path",
                "source_sha256",
                "command",
                "covers_surfaces"
              ],
              "properties": {
                "node_id": {"type": "string", "minLength": 1},
                "source_path": {"type": "string", "minLength": 1},
                "source_sha256": {"$ref": "#/$defs/sha256"},
                "command": {"$ref": "#/$defs/test_command"},
                "covers_surfaces": {
                  "type": "array",
                  "minItems": 1,
                  "items": {"type": "string", "minLength": 1}
                }
              }
            }
          }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "from_closure_id",
          "to_closure_id",
          "reason",
          "code_surfaces",
          "test_nodes"
        ],
        "properties": {
          "from_closure_id": {"type": "string", "minLength": 1},
          "to_closure_id": {"type": "string", "minLength": 1},
          "reason": {"type": "string", "minLength": 1},
          "code_surfaces": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          },
          "test_nodes": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_command": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "protocol",
        "argv",
        "certification_runtime_sha256",
        "environment_profile"
      ],
      "properties": {
        "protocol": {
          "type": "string",
          "const": "implement-v13-codex/test-command/1"
        },
        "argv": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "certification_runtime_sha256": {"$ref": "#/$defs/sha256"},
        "environment_profile": {
          "type": "string",
          "const": "controller_certification"
        }
      }
    }
  }
}
