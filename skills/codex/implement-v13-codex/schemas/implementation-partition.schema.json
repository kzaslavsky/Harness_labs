{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "limits", "groups"],
  "properties": {
    "protocol": {"type": "string", "const": "implement-v13-codex/implementation-partition/1"},
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_groups", "max_effort_per_group", "max_write_paths_per_group"],
      "properties": {
        "max_groups": {"type": "integer", "const": 3},
        "max_effort_per_group": {"type": "number", "const": 12},
        "max_write_paths_per_group": {"type": "integer", "const": 18}
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 3,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["group_id", "step_ids", "depends_on", "write_paths", "targeted_tests", "effort", "exceptions"],
        "properties": {
          "group_id": {"type": "string", "pattern": "^implementation_group_[1-3]$"},
          "step_ids": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
          "depends_on": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "write_paths": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "targeted_tests": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "effort": {"type": "number", "exclusiveMinimum": 0},
          "exceptions": {"type": "array", "items": {"type": "string", "minLength": 1}}
        }
      }
    }
  }
}
