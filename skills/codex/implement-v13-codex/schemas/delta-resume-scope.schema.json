{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "feature_run_id",
    "candidate_commit_sha",
    "ledger_path",
    "ledger_sha256",
    "ledger_state_revision",
    "open_closures",
    "open_fingerprints",
    "verification_slice"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "const": "implement-v13-codex/delta-resume-scope/1"
    },
    "feature_run_id": {"type": "string", "minLength": 1},
    "candidate_commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "ledger_path": {"type": "string", "minLength": 1},
    "ledger_sha256": {"$ref": "#/$defs/sha256"},
    "ledger_state_revision": {"type": "integer", "minimum": 0},
    "open_closures": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["closure_id", "status", "fingerprints"],
        "properties": {
          "closure_id": {"type": "string", "minLength": 1},
          "status": {"type": "string", "minLength": 1},
          "fingerprints": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "open_fingerprints": {
      "type": "array",
      "minItems": 1,
      "items": {"type": "string", "minLength": 1}
    },
    "verification_slice": {
      "type": "object",
      "additionalProperties": false,
      "required": ["test_nodes", "commands"],
      "properties": {
        "test_nodes": {
          "type": "array",
          "minItems": 1,
          "items": {"type": "string", "minLength": 1}
        },
        "commands": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  }
}
