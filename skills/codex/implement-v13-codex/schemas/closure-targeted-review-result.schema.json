{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "queue_run_id", "feature_run_id", "phase", "phase_detail", "role", "status", "findings", "regression_checks", "evidence"],
  "properties": {
    "protocol": {"type": "string"}, "queue_run_id": {"type": "string"}, "feature_run_id": {"type": "string"},
    "phase": {"type": "string"}, "phase_detail": {"type": "string"}, "role": {"type": "string"},
    "status": {"type": "string", "enum": ["passed", "blocked"]},
    "findings": {"type": "array", "minItems": 1, "items": {"type": "object", "additionalProperties": false, "required": ["fingerprint", "status", "evidence"], "properties": {"fingerprint": {"type": "string", "minLength": 1}, "status": {"type": "string", "enum": ["fixed", "not_fixed", "regression"]}, "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}}}},
    "regression_checks": {"type": "object", "additionalProperties": {"type": "boolean"}},
    "evidence": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}}
  }
}
