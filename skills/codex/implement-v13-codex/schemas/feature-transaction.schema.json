{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["protocol", "queue_run_id", "feature_run_id", "feature_index", "base_branch", "state", "state_revision", "history"],
  "properties": {
    "protocol": {"type": "string", "enum": ["implement-v13-codex/feature-transaction/1", "implement-v13-codex/feature-transaction/2"]},
    "state": {"type": "string", "enum": ["prepared", "feature_committed", "manifest_committed", "merge_prepared", "merged", "cleanup_complete", "feature_result_written", "dispatcher_ack"]},
    "state_revision": {"type": "integer", "minimum": 0},
    "history": {"type": "array", "minItems": 1},
    "controller_package_protocol": {"type": "string", "const": "implement-v13-codex/controller-package-manifest/1"},
    "controller_package_version": {"type": "string", "const": "1"},
    "controller_package_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "controller_package_path": {"type": "string", "minLength": 1},
    "controller_migration_id": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
  },
  "allOf": [{"if": {"properties": {"protocol": {"const": "implement-v13-codex/feature-transaction/2"}}, "required": ["protocol"]}, "then": {"required": ["controller_package_protocol", "controller_package_version", "controller_package_digest", "controller_package_path"]}}],
  "additionalProperties": true
}
