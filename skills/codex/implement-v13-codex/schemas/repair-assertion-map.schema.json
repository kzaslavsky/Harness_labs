{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "feature_run_id",
    "closure_id",
    "repository_root",
    "repository_identity",
    "test",
    "effect_contract_sha256",
    "assertions"
  ],
  "properties": {
    "protocol": {
      "type": "string",
      "enum": [
        "implement-v13-codex/repair-assertion-map/1",
        "implement-v13-codex/repair-assertion-map/2"
      ]
    },
    "feature_run_id": {"type": "string", "minLength": 1},
    "closure_id": {"type": "string", "minLength": 1},
    "repository_root": {"type": "string", "minLength": 1},
    "repository_identity": {"$ref": "#/$defs/sha256"},
    "test": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_path",
        "source_sha256",
        "node_id",
        "command"
      ],
      "properties": {
        "source_path": {"type": "string", "minLength": 1},
        "source_sha256": {"$ref": "#/$defs/sha256"},
        "node_id": {"type": "string", "minLength": 1},
        "command": {
          "oneOf": [
            {"type": "string", "minLength": 1},
            {"$ref": "#/$defs/test_command"}
          ]
        }
      }
    },
    "effect_contract_sha256": {"$ref": "#/$defs/sha256"},
    "assertions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "assertion_id",
          "test_node_id",
          "observation_source",
          "source_sha256",
          "governed_artifact",
          "effect",
          "expected_disposition"
        ],
        "properties": {
          "assertion_id": {"type": "string", "minLength": 1},
          "test_node_id": {"type": "string", "minLength": 1},
          "observation_source": {"type": "string", "minLength": 1},
          "source_sha256": {"$ref": "#/$defs/sha256"},
          "governed_artifact": {"type": "string", "minLength": 1},
          "effect": {"$ref": "#/$defs/effect"},
          "expected_disposition": {"$ref": "#/$defs/disposition"}
        }
      }
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "test_command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "argv", "certification_runtime_sha256", "environment_profile"],
      "properties": {
        "protocol": {"type": "string", "const": "implement-v13-codex/test-command/1"},
        "argv": {"type": "array", "minItems": 1, "items": {"type": "string", "minLength": 1}},
        "certification_runtime_sha256": {"$ref": "#/$defs/sha256"},
        "environment_profile": {"type": "string", "const": "controller_certification"}
      }
    },
    "effect": {
      "type": "string",
      "enum": [
        "failure_checkpoint",
        "blocked_queue",
        "failure_summary",
        "failure_event",
        "success_result",
        "success_receipt",
        "integration_artifact",
        "dispatcher_acknowledgement",
        "base_git_state"
      ]
    },
    "disposition": {
      "type": "string",
      "enum": [
        "must_persist",
        "must_remain_absent",
        "must_remain_unchanged"
      ]
    }
  }
}
