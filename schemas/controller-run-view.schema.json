{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/controller-run-view.schema.json",
  "title": "Hybrid controller coordinator projection",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "run_id",
    "objective",
    "revision",
    "status",
    "phase",
    "limits",
    "criteria",
    "tasks",
    "decisions",
    "claims",
    "findings",
    "artifacts",
    "completion_failures",
    "anomalies",
    "operator_questions",
    "coordinator_dispatch",
    "allowed_commands",
    "event_cursor"
  ],
  "properties": {
    "protocol": {
      "const": "controller-run-view/1"
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "status": {
      "type": "string",
      "minLength": 1
    },
    "phase": {
      "type": "string",
      "minLength": 1
    },
    "limits": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "max_depth",
        "max_subagents",
        "max_parallelism",
        "max_tasks"
      ],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 1 },
        "max_subagents": { "type": "integer", "minimum": 1 },
        "max_parallelism": {
          "type": ["integer", "null"],
          "minimum": 1
        },
        "max_tasks": {
          "type": ["integer", "null"],
          "minimum": 1
        }
      }
    },
    "criteria": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "tasks": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "decisions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "completion_failures": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "anomalies": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "operator_questions": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "coordinator_dispatch": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "active_session",
        "sessions"
      ],
      "properties": {
        "schema": {
          "type": [
            "object",
            "null"
          ]
        },
        "active_session": {
          "type": [
            "object",
            "null"
          ]
        },
        "sessions": {
          "type": "array",
          "items": {
            "type": "object"
          }
        }
      }
    },
    "allowed_commands": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "event_cursor": {
      "type": "integer",
      "minimum": 0
    }
  }
}
