{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/audit-manifest.schema.json",
  "title": "Harness terminal audit manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "run_id",
    "evidence_classification",
    "status",
    "started_at",
    "finished_at",
    "event_count",
    "head_hash",
    "checkpoint_sha256",
    "checkpoint_revision",
    "artifacts",
    "manifest_hash"
  ],
  "properties": {
    "protocol": { "const": "harness-audit-manifest/1" },
    "run_id": { "type": "string", "minLength": 1 },
    "evidence_classification": {
      "enum": [
        "production_lifecycle",
        "component",
        "synthetic",
        "fabricated_fixture"
      ]
    },
    "status": {
      "enum": ["succeeded", "failed", "blocked", "interrupted"]
    },
    "started_at": { "type": "string", "format": "date-time" },
    "finished_at": { "type": "string", "format": "date-time" },
    "event_count": { "type": "integer", "minimum": 1 },
    "head_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "checkpoint_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "checkpoint_revision": { "type": "integer", "minimum": 1 },
    "artifacts": {
      "type": "array",
      "items": { "$ref": "audit-event.schema.json#/$defs/artifact" }
    },
    "manifest_hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" }
  }
}
