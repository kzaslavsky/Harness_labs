{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/plangraph-metrics-snapshot.schema.json",
  "title": "PlanGraph metrics snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "identity", "display_name", "status", "timing", "graph_metrics", "feature_runs", "outcome", "data_quality", "provenance"],
  "properties": {
    "protocol": {"const": "plangraph-metrics-snapshot/1"},
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["logical_graph_id", "graph_attempt_id", "run_id", "plan_path", "plan_digest", "base_commit", "repository_id"],
      "properties": {
        "logical_graph_id": {"type": ["string", "null"]},
        "graph_attempt_id": {"type": ["string", "null"]},
        "run_id": {"type": "string", "minLength": 1},
        "plan_path": {"type": ["string", "null"]},
        "plan_digest": {"type": ["string", "null"]},
        "base_commit": {"type": ["string", "null"]},
        "repository_id": {"type": ["string", "null"]}
      }
    },
    "display_name": {"type": "string", "minLength": 1},
    "status": {"type": "string", "minLength": 1},
    "timing": {"$ref": "#/$defs/snapshotTiming"},
    "graph_metrics": {"$ref": "#/$defs/graphMetrics"},
    "feature_runs": {"type": "array", "items": {"$ref": "#/$defs/featureRunRow"}},
    "outcome": {"$ref": "#/$defs/outcome"},
    "data_quality": {"$ref": "#/$defs/dataQuality"},
    "provenance": {"$ref": "#/$defs/snapshotProvenance"}
  },
  "$defs": {
    "genericMetric": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "value", "reason"],
      "properties": {
        "state": {"enum": ["available", "partial", "unavailable"]},
        "value": {"type": ["number", "integer", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "tokenBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "input_tokens", "cached_input_tokens", "output_tokens", "total_tokens"],
      "properties": {
        "state": {"enum": ["available", "partial", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "input_tokens": {"type": ["integer", "null"]},
        "cached_input_tokens": {"type": ["integer", "null"]},
        "output_tokens": {"type": ["integer", "null"]},
        "total_tokens": {"type": ["integer", "null"]}
      }
    },
    "costBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "usd", "reason"],
      "properties": {
        "state": {"enum": ["available", "estimated", "unavailable"]},
        "usd": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]}
      }
    },
    "costRowRich": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "usd", "reason", "sources", "estimated_records", "long_context_records"],
      "properties": {
        "state": {"enum": ["available", "estimated", "unavailable"]},
        "usd": {"type": ["number", "null"]},
        "reason": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "estimated_records": {"type": "integer", "minimum": 0},
        "long_context_records": {"type": "integer", "minimum": 0}
      }
    },
    "ledgerBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "graph_launches", "gate_invocations", "repair_dispatches", "structural_decisions"],
      "properties": {
        "state": {"enum": ["available", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "graph_launches": {"type": ["integer", "null"]},
        "gate_invocations": {"type": ["integer", "null"]},
        "repair_dispatches": {"type": ["integer", "null"]},
        "structural_decisions": {"type": ["integer", "null"]}
      }
    },
    "distribution": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "mean", "median", "max", "sample_size", "population"],
      "properties": {
        "state": {"enum": ["available", "partial", "unavailable", "estimated"]},
        "reason": {"type": ["string", "null"]},
        "mean": {"type": ["number", "null"]},
        "median": {"type": ["number", "null"]},
        "max": {"type": ["number", "null"]},
        "sample_size": {"type": "integer", "minimum": 0},
        "population": {"type": "integer", "minimum": 0}
      }
    },
    "mergedTotals": {
      "type": "object",
      "additionalProperties": false,
      "required": ["calls", "input_tokens", "cached_input_tokens", "output_tokens", "duration_ms", "total_tokens", "peak_input_tokens", "wall_clock_ms", "busy_ms", "cost"],
      "properties": {
        "calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "peak_input_tokens": {"type": ["integer", "null"]},
        "wall_clock_ms": {"type": ["integer", "null"]},
        "busy_ms": {"type": ["integer", "null"]},
        "cost": {"$ref": "#/$defs/costRowRich"}
      }
    },
    "breakdownRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "calls", "input_tokens", "cached_input_tokens", "output_tokens", "duration_ms", "total_tokens", "peak_input_tokens", "cost"],
      "properties": {
        "label": {"type": "string"},
        "calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "peak_input_tokens": {"type": ["integer", "null"]},
        "wall_clock_ms": {"type": ["integer", "null"]},
        "busy_ms": {"type": ["integer", "null"]},
        "cost": {"$ref": "#/$defs/costRowRich"},
        "phase": {"type": "string"},
        "agent_type": {"type": "string"},
        "model": {"type": "string"},
        "effort": {"type": "string"},
        "backend": {"type": "string"}
      }
    },
    "byTryRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "calls", "input_tokens", "cached_input_tokens", "output_tokens", "duration_ms", "total_tokens", "peak_input_tokens", "wall_clock_ms", "busy_ms", "cost"],
      "properties": {
        "label": {"type": "string"},
        "calls": {"type": "integer", "minimum": 0},
        "input_tokens": {"type": "integer", "minimum": 0},
        "cached_input_tokens": {"type": "integer", "minimum": 0},
        "output_tokens": {"type": "integer", "minimum": 0},
        "duration_ms": {"type": "integer", "minimum": 0},
        "total_tokens": {"type": "integer", "minimum": 0},
        "peak_input_tokens": {"type": ["integer", "null"]},
        "wall_clock_ms": {"type": ["integer", "null"]},
        "busy_ms": {"type": ["integer", "null"]},
        "cost": {"$ref": "#/$defs/costRowRich"}
      }
    },
    "mergedStageRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "kind", "phase", "attempt", "status", "backend", "model", "effort", "duration_ms", "feature_run_id", "try_index"],
      "properties": {
        "label": {"type": "string"},
        "kind": {"type": "string"},
        "phase": {"type": "string"},
        "attempt": {"type": "string"},
        "status": {"type": "string"},
        "backend": {"type": "string"},
        "model": {"type": "string"},
        "effort": {"type": "string"},
        "duration_ms": {"type": ["integer", "null"]},
        "feature_run_id": {"type": "string"},
        "try_index": {"type": "integer", "minimum": 1}
      }
    },
    "qualityBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["criteria_total", "criteria_satisfied", "findings_total", "open_findings", "review_cycles", "verification_repairs"],
      "properties": {
        "criteria_total": {"type": "integer", "minimum": 0},
        "criteria_satisfied": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "open_findings": {"type": "integer", "minimum": 0},
        "review_cycles": {"type": "integer", "minimum": 0},
        "verification_repairs": {"type": "integer", "minimum": 0}
      }
    },
    "cumulativeQualityByTry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["label", "review_cycles", "verification_repairs", "findings_total"],
      "properties": {
        "label": {"type": "string"},
        "review_cycles": {"type": "integer", "minimum": 0},
        "verification_repairs": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0}
      }
    },
    "cumulativeQualityBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["review_cycles", "verification_repairs", "findings_total", "try_count", "reason", "by_try"],
      "properties": {
        "review_cycles": {"type": "integer", "minimum": 0},
        "verification_repairs": {"type": "integer", "minimum": 0},
        "findings_total": {"type": "integer", "minimum": 0},
        "try_count": {"type": "integer", "minimum": 1},
        "reason": {"type": "string"},
        "by_try": {"type": "array", "items": {"$ref": "#/$defs/cumulativeQualityByTry"}}
      }
    },
    "mergedProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["usage_records", "collection_method", "peak_context_definition", "busy_time_definition", "attempt_count", "current_run_id", "scope"],
      "properties": {
        "usage_records": {"type": "integer", "minimum": 0},
        "collection_method": {"type": "string"},
        "peak_context_definition": {"type": "string"},
        "busy_time_definition": {"type": "string"},
        "attempt_count": {"type": "integer", "minimum": 1},
        "current_run_id": {"type": "string"},
        "scope": {"const": "cumulative_plan_graph_node"}
      }
    },
    "detailMetricsDoc": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "totals", "quality", "by_phase", "by_agent", "by_agent_type", "by_model", "by_effort", "by_backend", "by_try", "stages", "cumulative_quality", "provenance"],
      "properties": {
        "protocol": {"const": "harness-run-detail-metrics/1"},
        "totals": {"$ref": "#/$defs/mergedTotals"},
        "quality": {"$ref": "#/$defs/qualityBlock"},
        "by_phase": {"type": "array", "items": {"$ref": "#/$defs/breakdownRow"}},
        "by_agent": {"type": "array", "items": {"$ref": "#/$defs/breakdownRow"}},
        "by_agent_type": {"type": "array", "items": {"$ref": "#/$defs/breakdownRow"}},
        "by_model": {"type": "array", "items": {"$ref": "#/$defs/breakdownRow"}},
        "by_effort": {"type": "array", "items": {"$ref": "#/$defs/breakdownRow"}},
        "by_backend": {"type": "array", "items": {"$ref": "#/$defs/breakdownRow"}},
        "by_try": {"type": "array", "items": {"$ref": "#/$defs/byTryRow"}},
        "stages": {"type": "array", "items": {"$ref": "#/$defs/mergedStageRow"}},
        "cumulative_quality": {"$ref": "#/$defs/cumulativeQualityBlock"},
        "provenance": {"$ref": "#/$defs/mergedProvenance"}
      }
    },
    "recoveryDisposition": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "disposition", "reason", "forced", "evidence_refs"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "disposition": {"enum": ["blocked", "sealed"]},
        "reason": {"type": ["string", "null"]},
        "forced": {"type": "boolean"},
        "evidence_refs": {"type": "array", "items": {"type": "string"}}
      }
    },
    "nodeTableRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "status", "tries", "detail", "totals", "wait_ms"],
      "properties": {
        "node_id": {"type": "string", "minLength": 1},
        "status": {"type": ["string", "null"]},
        "tries": {"type": "integer", "minimum": 0},
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {"state": {"enum": ["available", "unavailable"]}, "reason": {"type": ["string", "null"]}}
        },
        "totals": {"type": ["object", "null"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/mergedTotals"}}]},
        "wait_ms": {"$ref": "#/$defs/genericMetric"}
      }
    },
    "graphMetrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["protocol", "run_id", "status", "timing", "totals", "retries", "recovery", "blockers", "counts", "per_feature_run", "nodes", "scheduling", "cache", "lineage_totals"],
      "properties": {
        "protocol": {"const": "harness-plan-graph-metrics/1"},
        "run_id": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "timing": {
          "type": "object",
          "additionalProperties": false,
          "required": ["started_at", "wall_clock_ms"],
          "properties": {"started_at": {"type": ["string", "null"]}, "wall_clock_ms": {"$ref": "#/$defs/genericMetric"}}
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "cost", "calls", "agent_busy_ms", "parallelism", "peak_input_tokens"],
          "properties": {
            "tokens": {"$ref": "#/$defs/tokenBlock"},
            "cost": {"$ref": "#/$defs/costBlock"},
            "calls": {"$ref": "#/$defs/genericMetric"},
            "agent_busy_ms": {"$ref": "#/$defs/genericMetric"},
            "parallelism": {"$ref": "#/$defs/genericMetric"},
            "peak_input_tokens": {"$ref": "#/$defs/genericMetric"}
          }
        },
        "retries": {
          "type": "object",
          "additionalProperties": false,
          "required": ["budget_ledger", "node_retries", "graph_attempts"],
          "properties": {
            "budget_ledger": {"$ref": "#/$defs/ledgerBlock"},
            "node_retries": {"type": "integer", "minimum": 0},
            "graph_attempts": {"type": "integer", "minimum": 1}
          }
        },
        "recovery": {
          "type": "object",
          "additionalProperties": false,
          "required": ["dispositions", "attempt_lineage_count", "invalidations_count"],
          "properties": {
            "dispositions": {"type": "array", "items": {"$ref": "#/$defs/recoveryDisposition"}},
            "attempt_lineage_count": {"type": "integer", "minimum": 0},
            "invalidations_count": {"type": "integer", "minimum": 0}
          }
        },
        "blockers": {
          "type": "object",
          "additionalProperties": false,
          "required": ["count", "nodes"],
          "properties": {
            "count": {"type": "integer", "minimum": 0},
            "nodes": {
              "type": "array",
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": ["node_id", "reason"],
                "properties": {"node_id": {"type": "string", "minLength": 1}, "reason": {"type": ["string", "null"]}}
              }
            }
          }
        },
        "counts": {
          "type": "object",
          "additionalProperties": false,
          "required": ["logical_nodes", "feature_run_tries"],
          "properties": {"logical_nodes": {"type": "integer", "minimum": 0}, "feature_run_tries": {"type": "integer", "minimum": 0}}
        },
        "per_feature_run": {
          "type": "object",
          "additionalProperties": false,
          "required": ["wall_ms", "tokens", "cost_usd"],
          "properties": {
            "wall_ms": {"$ref": "#/$defs/distribution"},
            "tokens": {"$ref": "#/$defs/distribution"},
            "cost_usd": {"$ref": "#/$defs/distribution"}
          }
        },
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/nodeTableRow"}},
        "scheduling": {
          "type": "object",
          "additionalProperties": false,
          "required": ["critical_path_ms"],
          "properties": {"critical_path_ms": {"$ref": "#/$defs/genericMetric"}}
        },
        "cache": {
          "type": "object",
          "additionalProperties": false,
          "required": ["savings_usd"],
          "properties": {"savings_usd": {"$ref": "#/$defs/genericMetric"}}
        },
        "lineage_totals": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokens", "cost", "calls", "agent_busy_ms", "peak_input_tokens", "reason"],
          "properties": {
            "tokens": {"$ref": "#/$defs/tokenBlock"},
            "cost": {"$ref": "#/$defs/costBlock"},
            "calls": {"$ref": "#/$defs/genericMetric"},
            "agent_busy_ms": {"$ref": "#/$defs/genericMetric"},
            "peak_input_tokens": {"$ref": "#/$defs/genericMetric"},
            "reason": {"type": "string"}
          }
        }
      }
    },
    "snapshotTiming": {
      "type": "object",
      "additionalProperties": false,
      "required": ["started_at", "finished_at", "wall_clock_ms"],
      "properties": {
        "started_at": {"type": ["string", "null"]},
        "finished_at": {"type": ["string", "null"]},
        "wall_clock_ms": {"$ref": "#/$defs/genericMetric"}
      }
    },
    "featureRunRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "objective", "display_name", "status", "feature_run_id", "tries", "detail", "metrics"],
      "properties": {
        "node_id": {"type": ["string", "null"]},
        "objective": {"type": ["string", "null"]},
        "display_name": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "feature_run_id": {"type": ["string", "null"]},
        "tries": {"type": "integer", "minimum": 0},
        "detail": {
          "type": "object",
          "additionalProperties": false,
          "required": ["state", "reason"],
          "properties": {"state": {"enum": ["available", "unavailable"]}, "reason": {"type": ["string", "null"]}}
        },
        "metrics": {"type": ["object", "null"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/detailMetricsDoc"}}]}
      }
    },
    "outcomeNodeRow": {
      "type": "object",
      "additionalProperties": false,
      "required": ["node_id", "objective", "status", "criteria_satisfied", "criteria_total", "criteria_state", "evidence_reason"],
      "properties": {
        "node_id": {"type": ["string", "null"]},
        "objective": {"type": ["string", "null"]},
        "status": {"type": ["string", "null"]},
        "criteria_satisfied": {"type": ["integer", "null"]},
        "criteria_total": {"type": ["integer", "null"]},
        "criteria_state": {"enum": ["available", "unavailable"]},
        "evidence_reason": {"type": ["string", "null"]}
      }
    },
    "deltaBlock": {
      "type": "object",
      "additionalProperties": false,
      "required": ["state", "reason", "base_commit", "final_integrated_commit", "files_changed", "insertions", "deletions", "nodes"],
      "properties": {
        "state": {"enum": ["available", "unavailable"]},
        "reason": {"type": ["string", "null"]},
        "base_commit": {"type": ["string", "null"]},
        "final_integrated_commit": {"type": ["string", "null"]},
        "files_changed": {"type": ["integer", "null"]},
        "insertions": {"type": ["integer", "null"]},
        "deletions": {"type": ["integer", "null"]},
        "nodes": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["node_id", "candidate_commit"],
            "properties": {"node_id": {"type": ["string", "null"]}, "candidate_commit": {"type": ["string", "null"]}}
          }
        }
      }
    },
    "outcome": {
      "type": "object",
      "additionalProperties": false,
      "required": ["nodes", "nodes_total", "nodes_attempted", "nodes_succeeded", "nodes_blocked", "nodes_failed", "delta", "plan_sections", "acceptance_criteria", "narrative"],
      "properties": {
        "nodes": {"type": "array", "items": {"$ref": "#/$defs/outcomeNodeRow"}},
        "nodes_total": {"type": "integer", "minimum": 0},
        "nodes_attempted": {"type": "integer", "minimum": 0},
        "nodes_succeeded": {"type": "integer", "minimum": 0},
        "nodes_blocked": {"type": "integer", "minimum": 0},
        "nodes_failed": {"type": "integer", "minimum": 0},
        "delta": {"$ref": "#/$defs/deltaBlock"},
        "plan_sections": {"type": ["object", "null"]},
        "acceptance_criteria": {"type": ["object", "null"]},
        "narrative": {"type": "string", "minLength": 1}
      }
    },
    "dataQuality": {
      "type": "object",
      "additionalProperties": false,
      "required": ["summary_missing", "token_records_missing", "cost_state", "busy_unavailable_reason", "criteria_text_unavailable", "reconstructed", "reconstruction_notes", "completeness"],
      "properties": {
        "summary_missing": {"type": "boolean"},
        "token_records_missing": {"type": "boolean"},
        "cost_state": {"enum": ["available", "estimated", "unavailable"]},
        "busy_unavailable_reason": {"type": ["string", "null"]},
        "criteria_text_unavailable": {"type": "boolean"},
        "reconstructed": {"type": "boolean"},
        "reconstruction_notes": {"type": "array", "items": {"type": "string"}},
        "completeness": {"enum": ["complete", "partial", "minimal"]}
      }
    },
    "snapshotProvenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generated_at", "generator", "run_root", "reconstructed"],
      "properties": {
        "generated_at": {"type": "string", "format": "date-time"},
        "generator": {"type": "string", "minLength": 1},
        "run_root": {"type": "string", "minLength": 1},
        "reconstructed": {"type": "boolean"}
      }
    }
  }
}
