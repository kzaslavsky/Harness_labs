{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/controller-task-result.schema.json",
  "title": "Hybrid controller semantic task result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "summary",
    "claims",
    "findings",
    "artifacts",
    "criterion_coverage",
    "recommendations",
    "unresolved_questions",
    "delegation_requests",
    "details_schema",
    "details"
  ],
  "properties": {
    "protocol": {
      "const": "semantic-task-result/1"
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/claim"
      }
    },
    "findings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/finding"
      }
    },
    "artifacts": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/artifact"
      }
    },
    "criterion_coverage": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/coverage"
      }
    },
    "recommendations": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "unresolved_questions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "delegation_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "tasks"
        ],
        "properties": {
          "tasks": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "object"
            }
          },
          "max_parallelism": {
            "type": "integer",
            "minimum": 1
          }
        }
      }
    },
    "details_schema": {
      "type": "string",
      "minLength": 1
    },
    "details": {
      "type": "object"
    }
  },
  "$defs": {
    "claim": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "kind",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "enum": [
            "observed",
            "inferred"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "finding": {
      "type": "object",
      "required": [
        "id",
        "statement",
        "category",
        "severity",
        "evidence_refs"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "critical",
            "major",
            "minor",
            "info"
          ]
        },
        "requires_disposition": {
          "type": "boolean"
        },
        "evidence_refs": {
          "$ref": "#/$defs/references"
        },
        "source_finding_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "artifact": {
      "type": "object",
      "required": [
        "ref",
        "kind",
        "sha256",
        "media_type"
      ],
      "properties": {
        "ref": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "minLength": 1
        },
        "sha256": {
          "type": "string",
          "pattern": "^[a-f0-9]{64}$"
        },
        "media_type": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "coverage": {
      "type": "object",
      "required": [
        "criterion_id",
        "status",
        "evidence_refs"
      ],
      "properties": {
        "criterion_id": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "satisfied",
            "not_satisfied",
            "not_applicable"
          ]
        },
        "evidence_refs": {
          "$ref": "#/$defs/references"
        }
      }
    },
    "references": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    }
  }
}
