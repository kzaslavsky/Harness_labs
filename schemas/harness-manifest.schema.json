{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/harness-manifest.schema.json",
  "title": "Harness manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "name",
    "version",
    "lifecycle",
    "hierarchy_limits",
    "required_gates"
  ],
  "properties": {
    "schema_version": { "const": "1.0" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string", "minLength": 1 },
    "lifecycle": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": ["orient", "plan", "implement", "verify", "review", "integrate", "report"]
      }
    },
    "hierarchy_limits": {
      "type": "object",
      "additionalProperties": false,
      "required": ["max_depth", "max_subagents"],
      "properties": {
        "max_depth": { "type": "integer", "minimum": 1 },
        "max_subagents": { "type": "integer", "minimum": 1 },
        "max_retries": {
          "type": ["integer", "null"],
          "minimum": 0
        }
      }
    },
    "required_gates": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
