{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/controller-command.schema.json",
  "title": "Hybrid controller command",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "command_id",
    "run_id",
    "type",
    "actor",
    "expected_revision",
    "idempotency_key",
    "provenance",
    "payload"
  ],
  "properties": {
    "protocol": {
      "const": "harness-command/1"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "type": "string",
      "minLength": 1
    },
    "actor": {
      "$ref": "#/$defs/actor"
    },
    "expected_revision": {
      "type": "integer",
      "minimum": 0
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 1
    },
    "provenance": {
      "$ref": "#/$defs/provenance"
    },
    "payload": {
      "type": "object"
    }
  },
  "$defs": {
    "actor": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "role",
        "parent_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "type": "string",
          "minLength": 1
        },
        "parent_id": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "trigger_event",
        "evidence_refs"
      ],
      "properties": {
        "trigger_event": {
          "type": [
            "string",
            "null"
          ]
        },
        "evidence_refs": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    }
  }
}
