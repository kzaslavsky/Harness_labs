{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/dashboard-audit-root-registry.schema.json",
  "title": "Dashboard audit-root registry",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "audit_roots"],
  "properties": {
    "protocol": {"const": "harness-dashboard-audit-root-registry/1"},
    "audit_roots": {
      "type": "array",
      "minItems": 1,
      "maxItems": 16,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    }
  }
}
