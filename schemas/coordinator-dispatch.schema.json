{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/coordinator-dispatch.schema.json",
  "title": "Coordinator dispatch schema",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "schema_id",
    "segments"
  ],
  "properties": {
    "protocol": {
      "const": "coordinator-dispatch-schema/1"
    },
    "schema_id": {
      "type": "string",
      "minLength": 1
    },
    "segments": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/segment"
      }
    }
  },
  "$defs": {
    "segment": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "phases",
        "instructions",
        "coordinator_profile",
        "context",
        "max_attempts",
        "max_tool_calls"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "phases": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "instructions": {
          "type": "string",
          "minLength": 1
        },
        "coordinator_profile": {
          "type": "string",
          "minLength": 1
        },
        "context": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "artifact_kinds",
            "required_artifact_kinds"
          ],
          "properties": {
            "artifact_kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            },
            "required_artifact_kinds": {
              "type": "array",
              "uniqueItems": true,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "max_attempts": {
          "type": "integer",
          "minimum": 1
        },
        "max_tool_calls": {
          "type": "integer",
          "minimum": 1
        }
      }
    }
  }
}
