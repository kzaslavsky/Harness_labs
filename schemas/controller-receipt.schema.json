{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/controller-receipt.schema.json",
  "title": "Hybrid controller command receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "command_id",
    "run_id",
    "status",
    "revision",
    "event_ids",
    "effect_refs",
    "error_code",
    "message"
  ],
  "properties": {
    "protocol": {
      "const": "harness-command-receipt/1"
    },
    "command_id": {
      "type": "string",
      "minLength": 1
    },
    "run_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": [
        "accepted",
        "rejected",
        "duplicate"
      ]
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "event_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "effect_refs": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "error_code": {
      "type": [
        "string",
        "null"
      ]
    },
    "message": {
      "type": "string"
    }
  }
}
