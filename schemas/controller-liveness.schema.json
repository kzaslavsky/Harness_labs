{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/controller-liveness.schema.json",
  "title": "Ephemeral controller liveness lease",
  "description": "This lease is operational state, not durable audit evidence.",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "run_id", "controller_instance_id", "hostname", "pid", "process_start_token", "heartbeat_sequence", "heartbeat_at", "controller_kind"],
  "properties": {
    "protocol": {"const": "harness-controller-liveness/1"},
    "run_id": {"type": "string", "minLength": 1, "pattern": "^[^/]+$"},
    "controller_instance_id": {"type": "string", "minLength": 1},
    "hostname": {"type": "string", "minLength": 1},
    "pid": {"type": "integer", "minimum": 1},
    "process_start_token": {"type": "string", "minLength": 1},
    "heartbeat_sequence": {"type": "integer", "minimum": 0},
    "heartbeat_at": {"type": "string", "format": "date-time"},
    "controller_kind": {"enum": ["plan_graph", "feature_run"]}
  }
}
