{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/workspace-change-receipt.schema.json",
  "title": "Workspace change receipt",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "protocol",
    "repository",
    "baseline_head",
    "branch",
    "allowed_paths",
    "changed_paths",
    "files"
  ],
  "properties": {
    "protocol": { "const": "workspace-change-receipt/1" },
    "repository": { "type": "string", "minLength": 1 },
    "baseline_head": { "type": "string", "minLength": 1 },
    "branch": { "type": "string", "minLength": 1 },
    "allowed_paths": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "changed_paths": {
      "type": "array",
      "uniqueItems": true,
      "items": { "type": "string", "minLength": 1 }
    },
    "files": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "sha256"],
        "properties": {
          "kind": {
            "enum": ["file", "symlink", "directory", "deleted"]
          },
          "sha256": {
            "type": ["string", "null"],
            "pattern": "^[0-9a-f]{64}$"
          },
          "size_bytes": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}
