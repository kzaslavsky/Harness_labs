{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/run-catalog-snapshot.schema.json",
  "title": "Read-only run catalog snapshot",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "revision", "generated_at", "source_root", "availability", "diagnostics", "plan_graphs", "feature_runs", "ungrouped_feature_runs"],
  "properties": {
    "protocol": {"const": "harness-run-catalog-snapshot/1"},
    "revision": {"type": "string", "minLength": 1},
    "generated_at": {"type": "string", "format": "date-time"},
    "source_root": {"type": "string", "minLength": 1},
    "source_roots": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
    "availability": {"$ref": "#/$defs/availability"},
    "diagnostics": {"type": "array", "items": {"$ref": "#/$defs/diagnostic"}},
    "plan_graphs": {"type": "array", "items": {"$ref": "#/$defs/planGraph"}},
    "feature_runs": {"type": "array", "items": {"$ref": "#/$defs/featureRun"}},
    "ungrouped_feature_runs": {"type": "array", "items": {"$ref": "#/$defs/featureRun"}}
  },
  "$defs": {
    "availability": {"type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": {"state": {"enum": ["available", "partial", "unavailable"]}, "reason": {"type": ["string", "null"]}}},
    "diagnostic": {"type": "object", "additionalProperties": false, "required": ["code", "message", "run_id"], "properties": {"code": {"type": "string", "minLength": 1}, "message": {"type": "string", "minLength": 1}, "run_id": {"type": ["string", "null"]}, "source_root": {"type": ["string", "null"]}}},
    "liveness": {"type": "object", "additionalProperties": false, "required": ["state", "reason"], "properties": {"state": {"enum": ["live", "stale", "remote_unverified", "liveness_unavailable", "terminal", "not_applicable"]}, "reason": {"type": ["string", "null"]}}},
    "correlation": {"type": "object", "additionalProperties": false, "required": ["plan_graph_id", "plan_node_id", "parent_run_id"], "properties": {"plan_graph_id": {"type": "string", "minLength": 1}, "plan_node_id": {"type": "string", "minLength": 1}, "parent_run_id": {"type": "string", "minLength": 1}, "state": {"enum": ["id_matched"]}, "reason": {"type": "string", "minLength": 1}}, "dependentRequired": {"state": ["reason"], "reason": ["state"]}},
    "featureRun": {"type": "object", "additionalProperties": false, "required": ["run_id", "kind", "status", "liveness", "evidence", "correlation"], "properties": {"run_id": {"type": "string", "minLength": 1}, "kind": {"enum": ["feature_run", "legacy_feature_run"]}, "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked", "interrupted", "corrupt", "unknown"]}, "liveness": {"$ref": "#/$defs/liveness"}, "evidence": {"$ref": "#/$defs/availability"}, "correlation": {"type": ["null", "object"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/correlation"}}]}, "source_root": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}, "objective": {"type": ["string", "null"], "minLength": 1}}},
    "reusedNodeCorrelation": {"type": "object", "additionalProperties": false, "required": ["state", "origin_attempt_id", "origin_feature_run_id", "reused_from_attempt", "reason"], "properties": {"state": {"enum": ["reused"]}, "origin_attempt_id": {"type": "string", "minLength": 1}, "origin_feature_run_id": {"type": "string", "minLength": 1}, "reused_from_attempt": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}}},
    "planNode": {"type": "object", "additionalProperties": false, "required": ["node_id", "status", "feature_run_id", "depends_on", "liveness", "evidence"], "properties": {"node_id": {"type": "string", "minLength": 1}, "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked"]}, "feature_run_id": {"type": ["string", "null"]}, "reused_from_attempt": {"type": ["string", "null"]}, "candidate_commit": {"type": ["string", "null"]}, "correlation": {"type": ["null", "object"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/reusedNodeCorrelation"}}]}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "liveness": {"$ref": "#/$defs/liveness"}, "evidence": {"$ref": "#/$defs/availability"}, "objective": {"type": ["string", "null"], "minLength": 1}}},
    "executionAttempt": {"type": "object", "additionalProperties": false, "required": ["node_id", "logical_attempt", "allocation_id", "checkpoint_revision", "parent_candidate_commit", "expected_staging_head", "status", "candidate_commit"], "properties": {"node_id": {"type": "string", "minLength": 1}, "logical_attempt": {"type": "integer"}, "allocation_id": {"type": ["string", "null"]}, "checkpoint_revision": {"type": ["integer", "null"]}, "parent_candidate_commit": {"type": ["string", "null"]}, "expected_staging_head": {"type": ["string", "null"]}, "status": {"type": "string", "minLength": 1}, "candidate_commit": {"type": ["string", "null"]}}},
    "recoveryDisposition": {"type": "object", "additionalProperties": false, "required": ["node_id", "disposition", "reason", "forced", "evidence_refs"], "properties": {"node_id": {"type": "string", "minLength": 1}, "disposition": {"enum": ["blocked", "sealed"]}, "reason": {"type": ["string", "null"]}, "forced": {"type": "boolean"}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "integrationLeaseRecord": {"type": "object", "additionalProperties": false, "required": ["node_id", "lease_id", "expected_staging_head"], "properties": {"node_id": {"type": "string", "minLength": 1}, "lease_id": {"type": "string", "minLength": 1}, "expected_staging_head": {"type": "string", "minLength": 1}}},
    "integrationBarrier": {"type": "object", "additionalProperties": false, "required": ["barrier_id", "node_id", "attempt_id", "allocation_id", "logical_attempt", "checkpoint_revision", "lease_id", "action", "input_commit", "expected_staging_head", "integrated_commit", "evidence_refs"], "properties": {"barrier_id": {"type": ["string", "null"]}, "node_id": {"type": ["string", "null"]}, "attempt_id": {"type": ["string", "null"]}, "allocation_id": {"type": ["string", "null"]}, "logical_attempt": {"type": ["integer", "null"]}, "checkpoint_revision": {"type": ["integer", "null"]}, "lease_id": {"type": ["string", "null"]}, "action": {"type": ["string", "null"]}, "input_commit": {"type": ["string", "null"]}, "expected_staging_head": {"type": ["string", "null"]}, "integrated_commit": {"type": ["string", "null"]}, "evidence_refs": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}}},
    "attemptLineage": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "node_id", "logical_attempt", "allocation_id", "input_commit", "predecessor_attempt_id"], "properties": {"attempt_id": {"type": "string", "minLength": 1}, "node_id": {"type": "string", "minLength": 1}, "logical_attempt": {"type": "integer"}, "allocation_id": {"type": "string", "minLength": 1}, "input_commit": {"type": "string", "minLength": 1}, "predecessor_attempt_id": {"type": ["string", "null"]}}},
    "retryInvalidation": {"type": "object", "additionalProperties": false, "required": ["attempt_id", "node_id", "allocation_id", "reason", "invalidated_at"], "properties": {"attempt_id": {"type": "string", "minLength": 1}, "node_id": {"type": "string", "minLength": 1}, "allocation_id": {"type": "string", "minLength": 1}, "reason": {"type": "string", "minLength": 1}, "invalidated_at": {"type": "string", "minLength": 1}}},
    "retryReuse": {"type": "object", "additionalProperties": false, "required": ["node_id", "reused_from_attempt_id", "replacement_attempt_id"], "properties": {"node_id": {"type": "string", "minLength": 1}, "reused_from_attempt_id": {"type": "string", "minLength": 1}, "replacement_attempt_id": {"type": "string", "minLength": 1}}},
    "blockEscalation": {"type": "object", "additionalProperties": false, "required": ["escalated", "blocker_evidence_ref", "stable_path"], "properties": {"escalated": {"type": "boolean"}, "blocker_evidence_ref": {"type": ["string", "null"], "minLength": 1}, "stable_path": {"type": ["string", "null"], "minLength": 1}}},
    "planGraphExecution": {"type": "object", "additionalProperties": false, "required": ["logical_graph", "attempts", "concurrency", "integration", "recovery"], "properties": {"logical_graph": {"type": "object", "additionalProperties": false, "required": ["base_commit", "plan_digest", "plan_graph_digest"], "properties": {"base_commit": {"type": ["string", "null"]}, "plan_digest": {"type": ["string", "null"]}, "plan_graph_digest": {"type": ["string", "null"]}}}, "attempts": {"type": "array", "items": {"$ref": "#/$defs/executionAttempt"}}, "concurrency": {"type": "object", "additionalProperties": false, "required": ["active_nodes", "active_count", "max_parallelism"], "properties": {"active_nodes": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "active_count": {"type": "integer", "minimum": 0}, "max_parallelism": {"$ref": "#/$defs/availability"}}}, "integration": {"type": "object", "additionalProperties": false, "required": ["staging_head", "lease", "lease_record", "barriers"], "properties": {"staging_head": {"type": ["string", "null"]}, "lease": {"$ref": "#/$defs/availability"}, "lease_record": {"type": ["null", "object"], "allOf": [{"if": {"type": "object"}, "then": {"$ref": "#/$defs/integrationLeaseRecord"}}]}, "barriers": {"type": "array", "items": {"$ref": "#/$defs/integrationBarrier"}}}}, "recovery": {"type": "object", "additionalProperties": false, "required": ["active_allocations", "authority", "dispositions", "attempt_lineage", "retry_state"], "properties": {"active_allocations": {"type": "array", "items": {"$ref": "#/$defs/executionAttempt"}}, "authority": {"$ref": "#/$defs/availability"}, "dispositions": {"type": "array", "items": {"$ref": "#/$defs/recoveryDisposition"}}, "attempt_lineage": {"type": "array", "items": {"$ref": "#/$defs/attemptLineage"}}, "retry_state": {"type": "object", "additionalProperties": false, "required": ["invalidations", "reuse"], "properties": {"invalidations": {"type": "array", "items": {"$ref": "#/$defs/retryInvalidation"}}, "reuse": {"type": "array", "items": {"$ref": "#/$defs/retryReuse"}}}}}}, "block_escalation": {"$ref": "#/$defs/blockEscalation"}}},
    "planGraph": {"type": "object", "additionalProperties": false, "required": ["run_id", "created_at", "plan_path", "plan_digest", "plan_graph_digest", "status", "liveness", "evidence", "nodes"], "properties": {"run_id": {"type": "string", "minLength": 1}, "created_at": {"type": "string", "format": "date-time"}, "plan_path": {"type": "string", "minLength": 1}, "plan_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "plan_graph_digest": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "logical_graph_id": {"type": "string", "minLength": 1}, "graph_attempt_id": {"type": "string", "minLength": 1}, "predecessor_attempt_id": {"type": ["string", "null"], "minLength": 1}, "retention_constraints": {"$ref": "#/$defs/availability"}, "status": {"enum": ["queued", "running", "succeeded", "failed", "blocked", "interrupted", "corrupt"]}, "liveness": {"$ref": "#/$defs/liveness"}, "evidence": {"$ref": "#/$defs/availability"}, "nodes": {"type": "array", "items": {"$ref": "#/$defs/planNode"}}, "execution": {"$ref": "#/$defs/planGraphExecution"}, "source_root": {"type": "string", "minLength": 1}, "display_name": {"type": "string", "minLength": 1}}}
  }
}
