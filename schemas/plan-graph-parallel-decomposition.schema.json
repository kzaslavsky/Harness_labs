{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/plan-graph-parallel-decomposition.schema.json",
  "title": "Approved bounded parallel PlanGraph decomposition",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "graph_id", "plan_sha256", "base_commit", "execution_policy", "nodes"],
  "properties": {
    "protocol": {"const": "harness-plan-graph-parallel-decomposition/1"},
    "graph_id": {"$ref": "#/$defs/id"},
    "plan_sha256": {"$ref": "#/$defs/sha256"},
    "base_commit": {"$ref": "#/$defs/git_commit"},
    "execution_policy": {"$ref": "#/$defs/policy"},
    "nodes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/node"}}
  },
  "$defs": {
    "id": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$"},
    "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "git_commit": {"type": "string", "pattern": "^[a-f0-9]{40}$"},
    "policy": {"type": "object", "additionalProperties": false, "required": ["max_parallelism", "failure_policy", "graph_staging_branch", "base_branch"], "properties": {"max_parallelism": {"type": "integer", "minimum": 1}, "failure_policy": {"const": "collect_all"}, "graph_staging_branch": {"type": "string", "minLength": 1}, "base_branch": {"type": "string", "minLength": 1}}},
    "node": {"type": "object", "additionalProperties": false, "required": ["id", "depends_on", "parallel_group", "writable_paths", "role"], "properties": {"id": {"$ref": "#/$defs/id"}, "depends_on": {"type": "array", "uniqueItems": true, "items": {"$ref": "#/$defs/id"}}, "parallel_group": {"type": ["string", "null"]}, "writable_paths": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}}, "role": {"enum": ["lane", "join", "close"]}}}
  }
}
