{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://harness-labs.local/schemas/review-ledger.schema.json",
  "title": "FeatureRun review ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol", "policy", "risk_tier", "findings", "cycles"],
  "properties": {
    "protocol": { "const": "review-ledger/1" },
    "policy": {
      "type": "object",
      "additionalProperties": {
        "type": ["boolean", "integer", "number"]
      }
    },
    "risk_tier": { "enum": ["mechanical", "sensitive"] },
    "findings": {
      "type": "object",
      "additionalProperties": { "$ref": "#/$defs/finding" }
    },
    "scope_screening": {
      "type": "object",
      "description": "Tally of findings the scope guard screened out. A screened finding carries no obligation anywhere else in this document -- it is absent from every open-finding list by construction -- so this is the only place a screen is countable.",
      "properties": {
        "screened_count": { "type": "integer", "minimum": 0 },
        "screened_finding_keys": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "by_class": {
          "type": "object",
          "additionalProperties": { "type": "integer", "minimum": 0 }
        },
        "required_finding_keys": {
          "type": "array",
          "description": "Screened findings that carry requires_disposition or contract_violation. Those are exempt from screening, so this list is expected to be empty; a non-empty one means a required obligation was discharged in silence.",
          "items": { "type": "string", "minLength": 1 }
        }
      }
    },
    "cycles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["cycle", "review_attempt_id", "distinct_findings", "fix_keys"],
        "properties": {
          "cycle": { "type": "integer", "minimum": 1 },
          "review_attempt_id": { "type": "string", "minLength": 1 },
          "distinct_findings": { "type": "integer", "minimum": 0 },
          "fix_keys": {
            "type": "array",
            "items": { "type": "string", "minLength": 1 }
          }
        }
      }
    }
  },
  "$defs": {
    "finding": {
      "type": "object",
      "required": [
        "key",
        "file",
        "subject",
        "statement",
        "category",
        "severity",
        "score",
        "fix_cost",
        "protects",
        "requires_disposition",
        "contract_violation",
        "scope_expanding",
        "outcome",
        "cycles_seen",
        "occurrences",
        "source_finding_ids",
        "evidence_refs",
        "fix_attempts",
        "reopened_count"
      ],
      "properties": {
        "key": { "type": "string", "minLength": 1 },
        "file": {
          "type": "string",
          "description": "Repository-relative path the finding is anchored at, exactly as the reviewer wrote it -- it is half of the finding key, so it is never rewritten. Ledgers written before line/end_line existed embed the location here as 'path:N' or 'path:N-M'; such values still load and are read back into anchor_path/line/end_line. New producers write a bare path here and put the location in line/end_line."
        },
        "anchor_path": {
          "type": "string",
          "description": "The anchor as a normalized repository path: './' prefixes, duplicate separators and trailing slashes collapsed, and any legacy ':N'/':N-M' suffix removed. This, not file, is what the writable-path scope test reads."
        },
        "line": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "First line the finding refers to. Absent or null when the finding is about the file as a whole."
        },
        "end_line": {
          "type": ["integer", "null"],
          "minimum": 1,
          "description": "Last line of the range, when the finding spans one. Requires line and must not precede it. A single-line finding leaves this null rather than repeating line."
        },
        "subject": { "type": "string", "minLength": 1 },
        "statement": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["critical", "major", "minor", "info"] },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "fix_cost": { "type": "string", "minLength": 1 },
        "protects": { "type": "string" },
        "requires_disposition": { "type": "boolean" },
        "contract_violation": { "type": "boolean" },
        "scope_expanding": { "type": "boolean" },
        "outcome": {
          "enum": [
            "open",
            "pending_review",
            "fixed",
            "note",
            "scope_screened",
            "transferred",
            "deferred",
            "debt"
          ]
        },
        "outcome_reason": { "type": "string" },
        "origin_node": { "type": "string" },
        "transferred_to": { "type": "string" },
        "transfer_eligible": { "type": "boolean" },
        "required_paths": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "cycles_seen": {
          "type": "array",
          "items": { "type": "integer", "minimum": 1 }
        },
        "occurrences": { "type": "integer", "minimum": 1 },
        "source_finding_ids": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "evidence_refs": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "fix_attempts": { "type": "array", "items": { "type": "object" } },
        "reopened_count": { "type": "integer", "minimum": 0 },
        "anchor_out_of_grant": { "type": "boolean" },
        "inherited": {
          "type": "boolean",
          "description": "Seeded from another ledger (a cross-node transfer, or an obligation exported by a blocked predecessor). Such a record was minted against another grant, so this node's grant does not screen it."
        },
        "scope_screen_class": {
          "enum": ["", "anchor_out_of_grant", "scope_expanding"],
          "description": "Which screening branch disposed of this finding, when one did."
        }
      }
    }
  }
}
