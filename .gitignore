__pycache__/
*.py[cod]
.pytest_cache/
.DS_Store

# Harness run data is local evidence and may contain large transient artifacts.
logs/runs/*
!logs/runs/.gitkeep

# Temporary directories produced by initializer smoke tests.
initializing-compose.*
initializing-smoke.*

# Local experiment base repositories are embedded git repos, not branch content.
experiments/orbit/

# Plan-approval evidence and persisted registrations are local run state.
logs/plan-approval/
logs/registration/
experiments/archimedes/
experiments/retinology-demo/
experiments/rocketship/
experiments/trebuchet/
